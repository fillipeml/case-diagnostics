{
  "name": "case-diagnostics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Strategic diagnosis of a Brazilian civil case file: a two-call language-model pipeline whose output is checked against the file by deterministic grounding rules",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.mts",
    "eval": "node scripts/eval.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "mysql2": "^3.24.4",
    "next": "^16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.2"
  }
}
