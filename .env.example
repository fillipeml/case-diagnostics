# =============================================================================
# Case diagnostics. Copy to ".env.local" and fill in. NEVER commit the .env files.
# Every value below is a placeholder; the demo needs none of them.
# =============================================================================

# --- Demo ------------------------------------------------------------------------
# true = no model, no database, no bucket: the two sample cases are diagnosed from recorded
# readings, the store is in memory and uploads are archived under .demo/uploads (or not at all
# on a serverless host). Any other file is refused with an explanation.
DEMO_MODE=true

# --- Model (production) ----------------------------------------------------------
# The two-call pipeline: call 1 maps the case file in prose, call 2 writes the structured
# diagnosis from that map. Without a key and with DEMO_MODE unset, the app refuses to analyse.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Language of the diagnosis text: "en" or "pt-BR" (the case files are always Portuguese)
OUTPUT_LANGUAGE=en

# --- The client ------------------------------------------------------------------
# Name fragments of the firm's client (the defendant developer), comma separated, accent and
# case insensitive. They pick the CLIENT's defence out of the file: a plaintiff's rebuttal that
# also calls itself "contestação" must not be read as the defence.
CLIENT_NAME_FRAGMENTS=loteadora exemplo,exemplo urbanismo

# --- Knowledge base --------------------------------------------------------------
# JSON with recurring patterns per development, injected into call 2 to calibrate the diagnosis
# (see knowledge/patterns.json for the format). Empty = the fictional file shipped here.
KNOWLEDGE_PATH=

# --- Storage (production) --------------------------------------------------------
# MySQL-compatible URL (TiDB Cloud serverless works; TLS is required). Empty = in-memory store.
DATABASE_URL=
# Archive of every uploaded file (S3). Empty = local folder .demo/uploads, none on serverless.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Limits ----------------------------------------------------------------------
# Upload cap in MB. The host may cap lower: Vercel serverless request bodies are 4.5 MB.
MAX_UPLOAD_MB=50

# --- Access ----------------------------------------------------------------------
# Password of the app (without it the app is open, which is fine for the public demo)
APP_PASSWORD=
